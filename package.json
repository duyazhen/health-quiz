{
  "name": "health-quiz",
  "private": true,
  "version": "0.0.1",
  "packageManager": "pnpm@11.4.0",
  "scripts": {
    "dev": "pnpm --filter @health-quiz/web dev",
    "build": "pnpm --filter @health-quiz/web build",
    "start": "pnpm --filter @health-quiz/web start",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @health-quiz/web exec prisma generate",
    "db:format": "prisma format",
    "db:validate": "prisma validate"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/supertest": "^6.0.3",
    "prisma": "^6.16.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  }
}
